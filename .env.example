# Copiar a .env y completar. .env NUNCA se versiona.

# --- Jupyter (U1, pyspark/compose.yml) ---
JUPYTER_TOKEN=sintoken

# --- Kafka (stack lambda26, ver docs/stack-actual.md) ---
# Desde el host: localhost:49092 · desde un contenedor en lambda26-kafka-net: kafka:9092
KAFKA_BOOTSTRAP=localhost:49092
KAFKA_TOPIC=aqua-eventos-real
KAFKA_TOPIC_SERVICIO=servicio-eventos

# --- Firebase Realtime Database (entrada única de todas las fuentes) ---
FIREBASE_DB_URL=https://<proyecto>-default-rtdb.firebaseio.com
FIREBASE_PATH=/board1/lecturas/historial
# Login de usuario (lo usa el puente actual)
FIREBASE_API_KEY=
FIREBASE_EMAIL=
FIREBASE_PASSWORD=
# Cuenta de servicio (opcional, colector F2). Guardar el JSON en credenciales/, nunca en git.
FIREBASE_CREDENTIALS_PATH=./credenciales/firebase-sa.json

# --- APIs públicas (colector F2) ---
THINGSPEAK_CHANNEL_ID=
THINGSPEAK_READ_KEY=
EA_UK_STATION_ID=
USGS_SITE_ID=
OPENMETEO_LAT=-15.49
OPENMETEO_LON=-70.13
# Opcional: sube el límite de consultas de api.waterdata.usgs.gov (https://api.waterdata.usgs.gov/signup/)
USGS_API_KEY=
# Horas hacia atrás que el puente re-lee al reconectar; el colector no escribe lecturas más viejas
VENTANA_H=3

# --- Rutas locales (no versionadas) ---
CHECKPOINT_DIR=./checkpoints
DATA_DIR=./data/local
PARQUET_DIR=./data/local/parquet

# --- InfluxDB 2 (infra/compose.yml) ---
# Desde el host: http://localhost:48086 · desde un contenedor en lambda26-kafka-net: http://influxdb:8086
INFLUX_URL=http://localhost:48086
INFLUX_ORG=horeb
INFLUX_BUCKET=monitoraqua
INFLUX_RETENTION=30d
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=<min-8-caracteres>
# Token de administrador; también lo usa Grafana para el datasource InfluxDB
INFLUX_TOKEN=<token-largo-aleatorio>

# --- Grafana (infra/compose.yml, puerto 43000) ---
# Solo se aplican la primera vez que se crea el volumen de datos de Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
